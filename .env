# India Land Registry Backend - Environment Variables
# Copy this file to .env and fill in your actual values

# ==================== SERVER CONFIGURATION ====================
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app

# ==================== ADMIN AUTHENTICATION ====================
# This is your admin password for testing
# Change this to something secure!
ADMIN_PASSWORD=Password123

# ==================== BLOCKCHAIN CONFIGURATION ====================
# Get these from Kaleido after deploying smart contract
# Your Kaleido RPC URL (from node details)
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/DSyRlafQOHUtEPCxytaOC
# Your deployed contract address (from Remix after deployment)
CONTRACT_ADDRESS=0x355a170c57742eed74f20188Af137C1F521af37f

# Your wallet private key (from MetaMask or generated)
ADMIN_PRIVATE_KEY=0177d23a3bb19cfa388c3342a17ffceb0e4e3bdd4b2695bcf807326f2990ce5f

# ==================== DATABASE CONFIGURATION ====================
# Get these from Supabase project settings

# Supabase Project URL
SUPABASE_URL=https://rwzhpvbtqidsjbexttvc.supabase.co/rest/v1/

# Supabase anon/public key
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJ3emhwdmJ0cWlkc2piZXh0dHZjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcwNTg1NjIsImV4cCI6MjA5MjYzNDU2Mn0.POy207zKiXpzforfSrX1HEl6xmaZ0PpvFLf34KEeRBg
# ==================== DOCUMENT STORAGE (FREE OPTIONS) ====================
# Choose ONE of these options:

# Option 1: Web3.Storage (Recommended - Generous free tier)
# Get token from: https://web3.storage
WEB3_STORAGE_TOKEN=your-web3-storage-token

# Option 2: Pinata IPFS (Alternative - 1GB free)
# Get JWT from: https://pinata.cloud
# IPFS_HOST=api.pinata.cloud
# IPFS_AUTH=Bearer your-pinata-jwt

# Option 3: NFT.Storage (Alternative - Unlimited free)
# Get token from: https://nft.storage
# NFT_STORAGE_TOKEN=your-nft-storage-token

# ==================== NOTES ====================
# 1. All fields marked with "Your..." need to be replaced with actual values
# 2. Never commit .env file to git
# 3. Keep your private key secure
# 4. Admin password is used in X-Admin-Password header for all API requests
# 5. All document storage options are FREE with generous limits
# 6. For production, upgrade to paid tiers for higher limits
